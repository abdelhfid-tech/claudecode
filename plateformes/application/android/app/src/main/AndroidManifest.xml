<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Sauvegarde : aucune. allowBackup="false" (Android 11 et avant) et data_extraction_rules.xml (Android 12 et après :
         ni sauvegarde dans le compte du joueur, ni copie d'un téléphone à l'autre) : la partie ne quitte jamais l'appareil,
         comme le dit la page « Confidentialité ». Pour la mettre à l'abri ou changer de téléphone : « Enregistrer le fichier ». -->

    <!-- Autorisations. ISNAD n'appelle rien au-dehors : le jeu est dans l'application, polices comprises.
         INTERNET est celle que Capacitor pose d'office ; elle est gardée tant qu'on n'a pas prouvé, sur un téléphone,
         que l'application démarre sans elle (sa WebView sert le jeu depuis https://localhost, une adresse interceptée).
         Aucune autre autorisation n'est demandée (le manifeste fusionné est relevé par l'outil). -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
