<?xml version="1.0" encoding="utf-8"?>
<!-- ISNAD : rien ne quitte l'appareil — ni la sauvegarde dans le compte du joueur (cloud-backup), ni la copie d'un téléphone
     à l'autre (device-transfer). Lu par Android 12 et après (android:dataExtractionRules, AndroidManifest.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
