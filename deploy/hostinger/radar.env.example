# Réglages du radar sur le serveur (/etc/radar-decalage.env, lisible seulement par root et « radar »).

# Adresse du webhook du flux n8n « Radar : contenu réactif » (nœud « Candidats du radar »,
# adresse de production), par exemple : https://n8n.votre-domaine.com/webhook/radar-reactif
RADAR_N8N_WEBHOOK=
# Jeton partagé avec n8n (identifiant « Radar token » dans n8n, en-tête X-Radar-Token).
# Générez-le avec : openssl rand -hex 24
RADAR_N8N_TOKEN=

# Contact facultatif ajouté à l'identifiant envoyé aux sites (Wikimedia le recommande).
# Laisser vide est accepté : l'identifiant reste générique.
RADAR_CONTACT=
